# =========================
# Keep source files trackable
# =========================
!*/
!*.py
!*.sh
!*.f90
!*.F90
!*.f
!*.F
!*.c
!*.h
!*.hpp
!*.md
!Makefile
!CMakeLists.txt
!.gitignore


# =========================
# Python cache / environments
# =========================
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

.venv/
venv/
env/
ENV/
conda-meta/


# =========================
# Compiled / build files
# =========================
*.o
*.mod
*.smod
*.so
*.a
*.exe
*.out
*.x

build/
dist/
cmake-build-*/
CMakeFiles/
CMakeCache.txt


# =========================
# Large science data files
# =========================
*.nc
*.nc4
*.hdf
*.h5
*.he5
*.HDF
*.H5
*.dat
*.bin

*.npy
*.npz
*.pkl
*.pickle


# =========================
# Logs / job outputs
# =========================
logs/
log/
*.log
*.err
*.out
slurm-*.out
*.e[0-9]*
*.o[0-9]*


# =========================
# Generated outputs
# =========================
output/
outputs/
results/
figures/
plots/
tmp/
temp/


# =========================
# Images / documents generated by analysis
# =========================
*.png
*.jpg
*.jpeg
*.pdf
*.gif
*.tif
*.tiff
*.svg


# =========================
# Editor / OS files
# =========================
.DS_Store
.vscode/
.idea/
*~
*.swp
*.swo
